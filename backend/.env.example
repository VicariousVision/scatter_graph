# Copy to backend/.env (./setup.sh does this for you) and set NEO4J_PASSWORD.

# --- Neo4j (Neo4j Desktop: open your DBMS > Connection details) ---
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=gemma4:12b
EMBEDDING_MODEL=embeddinggemma:300m
# Must match the embedding model's output size. If you change the embedding model after
# ingesting documents, drop the "chunk_embeddings" index (and re-ingest) first.
EMBEDDING_DIMENSIONS=768
# One context size for extraction AND chat, so Ollama never reloads the model between them.
OLLAMA_NUM_CTX=16384
# Gemma 4 thinking mode stays off: it slows every call and adds nothing to JSON extraction.
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=900

# --- Ingestion ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
# Parallel LLM calls while extracting one document. Match Ollama's OLLAMA_NUM_PARALLEL.
EXTRACTION_CONCURRENCY=2
# Characters of each document sampled for automatic schema extraction.
SCHEMA_SAMPLE_CHARS=12000
MAX_UPLOAD_MB=50

# --- Question answering ---
RETRIEVAL_TOP_K=6
CHAT_TEMPERATURE=0.2
# Number of earlier messages sent to the LLM with each question.
HISTORY_WINDOW=10

# --- Server ---
# Only needed if the UI is served from a different origin than the API.
CORS_ORIGINS=["http://localhost:5173"]
